# Variables de entorno de Arcade Vault.
# Copia este archivo a .env.local (en la raíz del proyecto) y rellena los valores. .env.local no se versiona.

# API key de Resend (https://resend.com/api-keys). Secreta: nunca la subas al repositorio.
RESEND_API_KEY=

# Correo que recibe los mensajes del formulario de contacto de /about.
# Mientras no haya un dominio verificado en Resend, debe ser el correo de tu cuenta de Resend.
CONTACT_TO_EMAIL=

# Remitente de los correos. Si se deja vacío se usa "Arcade Vault <onboarding@resend.dev>".
CONTACT_FROM_EMAIL=
